# Copy to .env and fill in. NEVER commit the filled-in .env.

# ── Public origin ─────────────────────────────────────────────────────────────
# Domain Caddy serves + provisions TLS for. Must have a DNS A/AAAA record
# pointing at this host, and ports 80/443 reachable (for the ACME challenge).
MCP_PUBLIC_DOMAIN=mcp.example.com
# External HTTPS origin — the OAuth issuer + MCP resource id. This is the URL you
# add to Claude as the connector. Almost always https://${MCP_PUBLIC_DOMAIN}.
MCP_PUBLIC_URL=https://mcp.example.com

# ── Secrets — generate fresh, keep out of version control ─────────────────────
# Signs better-auth sessions/JWTs. Keep STABLE across restarts (rotating it logs
# everyone out).  Generate:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# AES-256 key encrypting 1С passwords at rest. LOSING THIS makes every stored 1С
# password unrecoverable — back it up in a secret manager.  openssl rand -base64 32
ONEC_MCP_ENC_KEY=
# Password for the bundled Postgres.  openssl rand -base64 24
POSTGRES_PASSWORD=
